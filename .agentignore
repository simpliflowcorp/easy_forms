# .agentignore - Files and folders to exclude from agent context
# Similar to .gitignore but for agent's file watching/context

# Documentation and checkpoint files
*.txt
*.log

# Checkpoint and planning documents
updates/
docs/

# Agent configuration and rules
.agents/

# Test reports and artifacts
tests/agent/eval/reports/
tests/agent/eval/*.json

# Build artifacts
.next/
out/
build/
dist/

# Dependencies
node_modules/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# Environment files


# OS files
.DS_Store
Thumbs.db

# Debug files
debug-*.ts
debug-*.js
test-*.ts
test-*.js

# Tree files

# MLLE and agent docs
MLLE.md
GEMINI.md
AGENTS.md

# Coverage reports
coverage/
.nyc_output/

# Test artifacts
*.tsbuildinfo