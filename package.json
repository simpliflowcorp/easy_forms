{
  "name": "easy_form_0.1.0",
  "description": "A powerful form builder with advanced features like AI integration, PDF generation, and real-time collaboration.",
  "author": "chromecodes",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "docker run -d --name easyforms-redis -p 6379:6379 redis:alpine 2>/dev/null || docker start easyforms-redis 2>/dev/null; next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "worker": "ts-node -r dotenv/config src/helper/backgroundWorker.ts",
    "agent:migrate": "ts-node -r dotenv/config scripts/migrate-agent-tickets.ts",
    "ws:server": "ts-node -r dotenv/config src/lib/wsServerEntry.ts",
    "dev:ws": "concurrently \"npm run dev\" \"npm run ws:server\"",
    "agent:eval": "ts-node -r dotenv/config tests/agent/eval/runner.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@json2csv/node": "^7.0.7",
    "@lottiefiles/lottie-player": "^2.0.12",
    "@react-pdf/renderer": "^4.5.1",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/redis": "^4.0.11",
    "@vercel/kv": "^3.0.0",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "buffer-equal-constant-time": "1.0.1",
    "dotenv": "^17.4.2",
    "fs": "^0.0.1-security",
    "hashids": "^2.3.0",
    "ioredis": "^5.11.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "9.0.3",
    "jwa": "2.0.1",
    "lodash": "^4.18.1",
    "lottie-react": "^2.4.1",
    "mongoose": "^9.8.1",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "node-cron": "^4.6.0",
    "node-llama-cpp": "^3.19.1",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "react": "^19",
    "react-dom": "^19",
    "react-hot-toast": "^2.6.0",
    "react-select": "^5.10.2",
    "react-tooltip": "^6.0.8",
    "recharts": "^3.10.1",
    "redis": "^6.1.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^8.2.2",
    "eslint": "^10",
    "eslint-config-next": "^16.2.12",
    "sass": "^1.102.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
